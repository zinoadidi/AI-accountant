# AI-accountant app
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Generic-crud backend (persistence + file store + Meta Spark relay).
# Run it alongside: see ../generic-crud-backend/API.md
# Azure: CRUD_BASE_URL="https://generic-crud.agreeabledesert-b2caaf68.norwayeast.azurecontainerapps.io/generic-crud"
CRUD_BASE_URL="http://127.0.0.1:3531/generic-crud"
# UUID namespacing this deployment's data. Generate one per environment:
#   node -e "console.log(crypto.randomUUID())"
CRUD_APP_ID="00000000-0000-4000-8000-000000000001"
# Passphrase for the backend's per-app lock (optional until the namespace
# is locked with POST /api/apps/:appId). Sent as `x-app-token`.
CRUD_APP_TOKEN=""
# Fixed admin login (/admin/login). Password itself is never stored here —
# only its bcrypt hash (generate: node -e "require('bcryptjs').hash('PW',10).then(console.log)").
ADMIN_EMAIL="admin@zinospot.local"
ADMIN_PASSWORD_HASH=""
