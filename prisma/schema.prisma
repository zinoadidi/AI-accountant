generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite has no native enum type, so role/status/type fields below are
// plain strings constrained by the TypeScript union types in src/lib/types.ts.
// Switching `provider` to "postgresql" for production allows converting these
// back to native Prisma enums if desired.

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  passwordHash        String
  name                String
  createdAt           DateTime     @default(now())
  memberships         Membership[]
  invitationsSent     Invitation[] @relation("InvitedBy")
  documentsUploaded   Document[]   @relation("UploadedBy")
  engagementsSent     Engagement[] @relation("EngagementInvitedBy")
  engagementsAccepted Engagement[] @relation("EngagementAccountant")
}

model Business {
  id               String            @id @default(cuid())
  name             String
  registryCode     String? // Estonian Ariregister code
  vatNumber        String?
  country          String            @default("EE")
  currency         String            @default("EUR")
  // Billing mode the owner has selected — scaffolding only, no payment
  // processing wired up yet. PAY_PER_REPORT | PROFESSIONAL_FEE | SUBSCRIPTION
  pricingMode      String?
  createdAt        DateTime          @default(now())
  memberships      Membership[]
  invitations      Invitation[]
  documents        Document[]
  filingPeriods    FilingPeriod[]
  engagements      Engagement[]
  invoiceTemplates InvoiceTemplate[]
  revenueEntries   RevenueEntry[]
}

model Membership {
  id         String   @id @default(cuid())
  role       String // OWNER | ACCOUNTANT | BOOKKEEPER | EMPLOYEE | VIEWER
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
}

model Invitation {
  id          String   @id @default(cuid())
  email       String
  role        String // ACCOUNTANT | BOOKKEEPER | EMPLOYEE | VIEWER
  status      String   @default("PENDING") // PENDING | ACCEPTED | REVOKED
  token       String   @unique
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  invitedBy   User     @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}

model Document {
  id                String   @id @default(cuid())
  business          Business @relation(fields: [businessId], references: [id])
  businessId        String
  fileName          String
  mimeType          String
  sizeBytes         Int
  type              String   @default("OTHER") // RECEIPT | BANK_STATEMENT | INVOICE | CONTRACT | OTHER
  status            String   @default("UPLOADED") // UPLOADED | CATEGORIZED | REVIEWED
  // AI-extracted / suggested fields — always distinguished from human-confirmed ones
  suggestedCategory String?
  suggestedVendor   String?
  suggestedAmount   Float?
  suggestedCurrency String?
  suggestedVatRate  Float?
  aiConfidence      Float?
  confirmedCategory String?
  uploadedBy        User     @relation("UploadedBy", fields: [uploadedById], references: [id])
  uploadedById      String
  createdAt         DateTime @default(now())
}

// A filing period is the scoping unit for a single statutory filing (a VAT
// return for a month, an annual report for a year, etc). Bank reconciliation,
// report drafting, and accountant review/sign-off are all organized around
// one of these, not around the business as a whole or a single document.
model FilingPeriod {
  id             String         @id @default(cuid())
  business       Business       @relation(fields: [businessId], references: [id])
  businessId     String
  label          String // e.g. "January 2026 VAT return"
  type           String // VAT | ANNUAL | OTHER
  periodStart    DateTime
  periodEnd      DateTime
  status         String         @default("OPEN") // OPEN | IN_REVIEW | FILED
  createdAt      DateTime       @default(now())
  engagements    Engagement[]
  revenueEntries RevenueEntry[]
}

// Per-filing accountant access — distinct from the standing, business-wide
// Membership role. An accountant can be granted access to review and sign
// just one filing period (e.g. sourced through a future marketplace) without
// becoming a permanent team member.
model Engagement {
  id             String       @id @default(cuid())
  business       Business     @relation(fields: [businessId], references: [id])
  businessId     String
  filingPeriod   FilingPeriod @relation(fields: [filingPeriodId], references: [id])
  filingPeriodId String
  email          String
  status         String       @default("PENDING") // PENDING | ACTIVE | COMPLETED | REVOKED
  token          String       @unique
  invitedBy      User         @relation("EngagementInvitedBy", fields: [invitedById], references: [id])
  invitedById    String
  accountant     User?        @relation("EngagementAccountant", fields: [accountantId], references: [id])
  accountantId   String?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
}

// The business's own invoice design, uploaded once and reused. `html` holds
// the raw markup with {{placeholder}} tokens (see src/lib/invoicing.ts for
// the token list) that get substituted per generated invoice.
model InvoiceTemplate {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  name       String
  html       String
  createdAt  DateTime @default(now())
}

// One candidate outgoing invoice, scoped to a filing period. In the absence
// of live bank sync (phase 1, not yet built) these are entered manually or
// via CSV bulk import; once that exists, unmatched revenue transactions
// will create these automatically instead.
//
// Whether an entry needs an invoice at all is a human decision, not a
// hardcoded legal rule — `suggestedNoInvoiceReason` is an AI-suggested,
// non-binding hint (same "suggested vs. confirmed" pattern as Document),
// and `noInvoiceReason` is only ever set by an explicit human action.
model RevenueEntry {
  id                  String       @id @default(cuid())
  business            Business     @relation(fields: [businessId], references: [id])
  businessId          String
  filingPeriod        FilingPeriod @relation(fields: [filingPeriodId], references: [id])
  filingPeriodId      String
  transactionDate     DateTime
  amount              Float
  currency            String       @default("EUR")
  description         String? // raw bank statement memo/reference
  counterpartyNameRaw String? // payer name as it appears on the statement

  status                   String  @default("NEEDS_INVOICE") // NEEDS_INVOICE | NO_INVOICE_NEEDED | INVOICE_GENERATED
  suggestedNoInvoiceReason String? // AI-suggested hint only, never authoritative
  noInvoiceReason          String? // set only by an explicit human decision

  // Rectifiable customer details — filled in one at a time or via CSV bulk import
  customerName         String?
  customerRegistryCode String?
  customerVatNumber    String?
  customerAddress      String?
  customerEmail        String?

  invoiceTemplateId String?
  invoiceNumber     String?
  invoiceHtml       String?
  generatedAt       DateTime?

  createdAt DateTime @default(now())
}
